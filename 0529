      },
      "execution_count": 30,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 8) Create an agent with the tool\n",
        "agent = create_agent(\n",
        "    model=model,\n",
        "    tools=[word_count],\n",
        "    system_prompt=\"You are a helpful assistant. Use tools when useful.\"\n",
        ")"
      ],
      "metadata": {
