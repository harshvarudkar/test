    {
      "cell_type": "code",
      "source": [
        "from langchain.agents import create_agent\n",
        "from langchain_core.tools import tool\n",
        "from langchain_openai import ChatOpenAI"
      ],
      "metadata": {
        "id": "7SuaKQifkryO"
      },
      "execution_count": 3,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "@tool\n",
        "def multiply(a: int, b: int) -> int:\n",
        "    \"\"\"Multiply two integers.\"\"\"\n",
        "    return a * b"
      ],
      "metadata": {
        "id": "CkyKgFPJkuo7"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "@tool\n",
        "def count_letters(text: str) -> int:\n",
        "    \"\"\"Count letters in text, excluding spaces and punctuation.\"\"\"\n",
        "    return sum(1 for ch in text if ch.isalpha())"
      ],
      "metadata": {
        "id": "o5_cl8Q2kxAy"
      },
      "execution_count": 5,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "llm = ChatOpenAI(model=\"gpt-4o-mini\", temperature=0)"
      ],
      "metadata": {
        "id": "tee6_SFokzXw"
      },
      "execution_count": 6,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "agent = create_agent(\n",
        "    model=llm,\n",
        "    tools=[multiply, count_letters],\n",
        "    system_prompt=\"You are a helpful assistant. Use tools when useful.\"\n",
        ")"
      ],
      "metadata": {
        "id": "gCDfziQGk3pv"
      },
      "execution_count": 7,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "response = agent.invoke(\n",
        "    {\n",
        "        \"messages\": [\n",
        "            {\n",
        "                \"role\": \"user\",\n",
        "                \"content\": \"how many letters are in 'Deloitte'?\"\n",
        "            }\n",
        "        ]\n",
        "    }\n",
        ")\n",
        "\n",
        "#What is 23 times 19, and how many letters are in 'Google Colab agent'?"
      ],
